# Supabase do Schedule Button (projeto Schedule-button-v2)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Senha do painel /setup
ADMIN_PASSWORD=

# Link assinado do setup do CRM (CRM#219): o setup do CRM abre o /setup daqui
# por GET /api/setup/entrar?t=<token>, sem a senha. Segredo só para isso, igual
# ao BOTAO_SETUP_SEGREDO do CRM e diferente de qualquer outro segredo daqui.
# Opcional: sem ele, o link vale na versão 2 (Ed25519), com a chave pública na
# linha setup_link_chave_publica de public.configuracao_do_servidor. Sem ele e
# sem a linha: a rota responde 503 e só a senha entra. Gere com: openssl rand -hex 32
SETUP_LINK_SEGREDO=
# Desliga a entrada por senha (só "1" ou "true" desligam). Ligada, o /setup só
# abre pelo setup do CRM. Desligar em produção só com OK da equipe.
SETUP_SENHA_DESLIGADA=

# Provisionamento pelo setup do CRM (CRM#217): chave de serviço que o worker do
# CRM manda em POST /api/provisionamento (Authorization: Bearer <chave>). A mesma
# do BOTAO_CHAVE_DE_PROVISIONAMENTO do CRM. Opcional: sem ela, o botão confere o
# sha256 da chave na linha provisionamento_sha256 de public.configuracao_do_servidor.
# Sem ela e sem a linha: a rota responde 503 e o CRM marca o envio com erro.
CHAVE_DE_PROVISIONAMENTO=

# CRM ContactIA (opcional): endereço da API, para apontar a um CRM de teste.
# Padrão: https://crm.contactia.com.br/api/v1. A chave do CRM é por clínica,
# gravada no Setup ("Chave da API do CRM"), não em variável de ambiente.
CRM_API_URL=

# Prova de origem das rotas do operador (opcional). O próprio app é aceito
# sempre, pelo host do pedido (domínio da Vercel ou domínio próprio). Aqui vão
# os hosts aceitos além dele, separados por vírgula, cada um com os subdomínios:
# o host da plataforma onde o botão abre, ex. app.fluxodonto.com.
# Vazio: só o próprio app, que é o que o botão usa hoje.
EMBED_HOSTS=
